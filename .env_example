# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# --- Azure OpenAI (source model — current deployment) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key-or-leave-blank-when-using-managed-identity>
AZURE_OPENAI_API_VERSION=2025-06-01
AZURE_OPENAI_SOURCE_DEPLOYMENT=gpt-4o

# --- Azure OpenAI (target model — candidate deployment) ---
AZURE_OPENAI_TARGET_DEPLOYMENT=gpt-4.1

# --- Optional: judge model for LLM-as-Judge evaluation ---
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4.1

# --- Optional: Microsoft Foundry project (cloud eval) ---
AZURE_AI_PROJECT_CONNECTION_STRING=
